{
  "name": "dbml-formatter",
  "displayName": "DBML Formatter - The best and only DBML formatter",
  "description": "Format .dbml files with ease",
  "version": "0.0.7",
  "repository": {
    "type": "git",
    "url": "https://github.com/idoaflalo/dbml-formatter"
  },
  "icon": "assets/icon.png",
  "publisher": "aflalo",
  "engines": {
    "vscode": "^1.80.0"
  },
  "keywords": [
    "dbml",
    "formatter",
    "database",
    "sql",
    "mongodb",
    "mysql",
    "postgres",
    "sqlite",
    "mariadb",
    "db2",
    "oracle",
    "mssql"
  ],
  "categories": [
    "Formatters",
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:dbml"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "dbml",
        "aliases": [
          "DBML",
          "dbml"
        ],
        "extensions": [
          ".dbml"
        ]
      }
    ]
  },
  "scripts": {
    "publish": "vsce publish",
    "package": "vsce package",
    "revert-sample": "git checkout HEAD -- test/sample.dbml"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^3.9.2"
  },
  "dependencies": {
    "@dbml/core": "^5.3.1"
  },
  "overrides": {
    "lodash": "^4.18.1",
    "lodash-es": "^4.18.1",
    "form-data": "^4.0.6",
    "jws": "^4.0.1",
    "linkify-it": "^5.0.2",
    "markdown-it": "^14.3.0",
    "qs": "^6.15.3",
    "tar-fs": "^3.1.3",
    "tmp": "^0.2.7",
    "underscore": "^1.13.8",
    "undici": "^8.7.0",
    "uuid": "^14.0.1"
  }
}
